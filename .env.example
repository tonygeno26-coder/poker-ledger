STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_PRICE_ID=
STRIPE_LIVE_WEBHOOK_SECRET=

BASE_URL=
PORT=3000
